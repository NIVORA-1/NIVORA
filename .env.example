# ==============================================================================
# NIVORA - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env or .env.local for local development:
#   cp .env.example .env.local
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# Database Connection (Prisma + Supabase PostgreSQL)
# Connect to Postgres via the shared transaction-mode pooler (Port 6543 / PgBouncer)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"

# Connect to Postgres via the direct session-mode connection (Port 5432, used for migrations)
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Authentication & Security
# Required in production. Used to sign and verify student JWT session tokens.
JWT_SECRET="your-super-secret-jwt-key"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Configuration
# Obtain Project URL and anon public key from:
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://zlknmubopaubuitdgjft.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Email Delivery (Optional - falls back to dev simulation logging if omitted)
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="NIVORA Security <security@nivora.edu>"

# OAuth Authentication (Google & GitHub)
# IMPORTANT: With Supabase OAuth, provider credentials are configured in your Supabase Dashboard:
# -> Supabase Dashboard -> Authentication -> Providers -> Google & GitHub.
#
# DO NOT expose client secrets in your frontend .env.
# 
# Provider Callback URL (configured in Google Cloud Console & GitHub OAuth Apps):
# https://zlknmubopaubuitdgjft.supabase.co/auth/v1/callback
#
# Nivora Redirect URLs (configured in Supabase Dashboard -> Authentication -> URL Configuration):
# Site URL: http://localhost:3000
# Redirect URLs:
#   - http://localhost:3000/auth/callback
#   - http://localhost:3000/**
#   - http://192.168.1.18:3000/auth/callback
#   - http://192.168.1.18:3000/**

# Google Gemini AI API Configuration (Completely Free Tier — No Credit Card Required)
# Obtain your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-google-gemini-free-api-key"
GEMINI_MODEL="gemini-1.5-flash"

# Hosted Discourse Community Platform (Free Tier / Hosted)
NEXT_PUBLIC_DISCOURSE_URL="https://nivora.discourse.group"
# External Event Providers (Optional)
# Meetup API Key for aggregating local tech meetups (leave empty for public feeds only)
MEETUP_API_KEY=""

# YouTube Data API v3 (Server-Side Only - Never prefix with NEXT_PUBLIC_)
# Obtain from Google Cloud Console -> APIs & Services -> Enable 'YouTube Data API v3' -> Credentials
YOUTUBE_API_KEY="your-youtube-data-api-key"
